---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Fehler 404 – Diese Seite wurde nicht gefunden" description="Diese Seite wurde nicht gefunden." robots="noindex, nofollow">
  <Navigation />
  <main id="main-content">
    <div id="error-404" class="container">
      <div>
        <Icon name="triangle-exclamation" />
        <h2>Fehler 404<br />Diese Seite wurde nicht gefunden</h2>
        <p>Die von Ihnen aufgerufene Seite existiert nicht oder wurde verschoben. <br />Bitte nutzen Sie unser Menü oder den folgenden Button, um zur Startseite zu gelangen.</p>
      </div>
      <div>
        <a class="button" href="/" aria-label="Zurück zur Startseite">Zur Startseite</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  #error-404 {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    height: calc(100vh - 74.8px);
    min-height: 30rem;
    margin-top: -96px;
    text-align: center;
    gap: 4rem;
  }
  #error-404 :global(.icon) {
    width: 4rem;
    height: 4rem;
    color: orangered;
  }
</style>
