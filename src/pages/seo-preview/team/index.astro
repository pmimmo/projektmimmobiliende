---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import SeoPreviewLayout from '../../../layouts/SeoPreviewLayout.astro';
import portraitGebhard from '../../../assets/img/portrait-gebhard.jpg';
import portraitNeuer from '../../../assets/img/portrait-neuer.jpg';

const base = import.meta.env.BASE_URL;
const people = (await getCollection('people'))
  .filter((person) => person.data.showDetailPage)
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'de'));
const portraitByPerson = {
  'ruediger-neuer': portraitNeuer,
  'juergen-gebhard': portraitGebhard,
};
---

<SeoPreviewLayout
  title="Team und Expertise"
  description="Vorschau der künftigen Teamstruktur mit Personenprofilen, Rollen, Leistungsfokus und Zertifikatsbezug."
  canonicalPath="/seo-preview/team/"
  eyebrow="Bereichsseite"
>
  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Personen als Vertrauensanker</h2>
      <p>Gerade bei Bewertung, Mediation und diskreter Vermittlung sollte sichtbar sein, wer fachlich wofür steht.</p>
    </div>
    <div class="seo-preview-grid">
      {people.map((person) => (
        <a class="seo-preview-media-card seo-preview-card-link" href={`${base}seo-preview/team/${person.id}/`}>
          <div class="seo-preview-media-card__image">
            <Picture src={portraitByPerson[person.id as keyof typeof portraitByPerson]} formats={['avif', 'webp']} alt={person.data.name} loading="lazy" decoding="async" />
          </div>
          <div class="seo-preview-media-card__body">
            <span class="seo-preview-kicker">{person.data.role === 'owner' ? 'Inhaber' : 'Team'}</span>
            <h3>{person.data.name}</h3>
            <p>{person.data.jobTitle}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</SeoPreviewLayout>
