---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import SeoPreviewLayout from '../../../layouts/SeoPreviewLayout.astro';
import portraitGebhard from '../../../assets/img/portrait-gebhard.jpg';
import portraitNeuer from '../../../assets/img/portrait-neuer-1zu1.jpg';

export async function getStaticPaths() {
  const people = await getCollection('people');

  return people
    .filter((person) => person.data.showDetailPage)
    .map((person) => ({
      params: { id: person.id },
      props: { person },
    }));
}

const { person } = Astro.props;

const [certifications, services, locations] = await Promise.all([
  getCollection('certifications'),
  getCollection('services'),
  getCollection('locations'),
]);

const certificationsById = new Map(certifications.map((certification) => [certification.id, certification.data]));
const servicesById = new Map(services.map((service) => [service.id, service.data]));
const locationsById = new Map(locations.map((location) => [location.id, location.data]));
const base = import.meta.env.BASE_URL;

const title = `${person.data.name}: ${person.data.jobTitle}`;
const description = person.data.shortBio || `${person.data.name} bei Projekt M Immobilien.`;
const portraitByPerson = {
  'ruediger-neuer': portraitNeuer,
  'juergen-gebhard': portraitGebhard,
};
const portrait = portraitByPerson[person.id as keyof typeof portraitByPerson];
---

<SeoPreviewLayout
  title={title}
  description={description}
  canonicalPath={`/seo-preview/team/${person.id}/`}
  eyebrow={person.data.role === 'owner' ? 'Personenprofil Inhaber' : 'Personenprofil Team'}
>
  <section class="seo-preview-section">
    <div class="seo-preview-person-intro">
      {portrait && (
        <div class="seo-preview-person-intro__image">
          <Picture src={portrait} formats={['avif', 'webp']} alt={person.data.name} loading="eager" decoding="async" />
        </div>
      )}
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">{person.data.role === 'owner' ? 'Inhaberprofil' : 'Teamprofil'}</p>
        <h2>{person.data.name}</h2>
        <p class="lead">{person.data.shortBio}</p>
        <div class="seo-preview-pill-list">
          {person.data.locations.map((id) => <span class="seo-preview-pill">{locationsById.get(id)?.title || id}</span>)}
          {person.data.serviceFocus.map((id) => <span class="seo-preview-pill">{servicesById.get(id)?.shortTitle || servicesById.get(id)?.title || id}</span>)}
        </div>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">SEO-Aufgabe dieser Seite</p>
        <h2>Expertise sichtbar machen</h2>
        <p>Diese Seite soll später personenbezogene Erfahrung, Rollen, Zertifizierungen und regionale Zuständigkeit bündig erklären.</p>
      </article>
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">Geplanter Seitentyp</p>
        <h2>Team-Detailseite</h2>
        <p>Geeignet für E-E-A-T-Signale, interne Verlinkung und klare Zuordnung von Gutachter-, Makler- und Mediationskompetenz.</p>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Profil und Zuständigkeit</h2>
      <p>Diese Informationen kommen aus der Personen-Collection und können später automatisch auf Team-, Leistungs- und Standortseiten auftauchen.</p>
    </div>
    <dl class="seo-preview-dl">
      <div>
        <dt>Rolle</dt>
        <dd>{person.data.role === 'owner' ? 'Inhaber / Geschäftsführung' : 'Team'}</dd>
      </div>
      <div>
        <dt>Standorte</dt>
        <dd>{person.data.locations.map((id) => locationsById.get(id)?.title || id).join(', ')}</dd>
      </div>
      <div>
        <dt>Leistungsfokus</dt>
        <dd>{person.data.serviceFocus.map((id) => servicesById.get(id)?.title || id).join(', ') || 'Noch nicht hinterlegt'}</dd>
      </div>
      <div>
        <dt>Zertifizierungen</dt>
        <dd>{person.data.certifications.map((id) => certificationsById.get(id)?.title || id).join(', ') || 'Keine personenbezogenen Zertifikate hinterlegt'}</dd>
      </div>
    </dl>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Verknüpfte Inhalte</h2>
      <p>Die Seite soll nicht isoliert stehen, sondern fachliche und lokale Einstiege sinnvoll weiterführen.</p>
    </div>
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <h3>Profiltext</h3>
        <p>{person.data.shortBio}</p>
      </article>
      <article class="seo-preview-card">
        <h3>Leistungsseiten</h3>
        <ul class="seo-preview-list">
          {person.data.serviceFocus.map((id) => (
            <li><a href={`${base}seo-preview/leistungen/${id}/`}>{servicesById.get(id)?.title || id}</a></li>
          ))}
        </ul>
      </article>
      <article class="seo-preview-card">
        <h3>Standortseiten</h3>
        <ul class="seo-preview-list">
          {person.data.locations.map((id) => (
            <li><a href={`${base}seo-preview/standorte/${id}/`}>{locationsById.get(id)?.title || id}</a></li>
          ))}
        </ul>
      </article>
      <article class="seo-preview-card">
        <h3>Zertifikate</h3>
        <ul class="seo-preview-list">
          {
            person.data.certifications.length
              ? person.data.certifications.map((id) => (
                  <li><a href={`${base}seo-preview/zertifikate/${id}/`}>{certificationsById.get(id)?.title || id}</a></li>
                ))
              : <li>Keine personenbezogenen Zertifikate hinterlegt.</li>
          }
        </ul>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <article class="seo-preview-card">
      <p class="seo-preview-kicker">Geplanter CTA</p>
      <h2>Persönliche Einschätzung anfragen</h2>
      <p>Später kann hier ein direkter Kontaktpunkt für Bewertung, Verkauf oder Mediation stehen, ohne die Seite mit Objektangeboten zu vermischen.</p>
      <a class="seo-preview-link" href={`${base}#callToAction`}>Kontaktbereich der aktuellen Seite ansehen</a>
    </article>
  </section>
</SeoPreviewLayout>
