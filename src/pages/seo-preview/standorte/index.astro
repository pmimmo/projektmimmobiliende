---
import { getCollection } from 'astro:content';
import SeoPreviewLayout from '../../../layouts/SeoPreviewLayout.astro';

const base = import.meta.env.BASE_URL;
const locations = (await getCollection('locations'))
  .filter((location) => location.data.previewPage)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'));
---

<SeoPreviewLayout
  title="Standorte"
  description="Projekt M Immobilien berät Eigentümer in München, Landshut und Umgebung persönlich zu Immobilienverkauf, Immobilienbewertung und vertraulichen Immobilienfragen."
  canonicalPath="/seo-preview/standorte/"
  eyebrow="Regionen"
>
  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Vor Ort ansprechbar</h2>
      <p>Immobilienentscheidungen sind lokal. Wir verbinden regionale Marktkenntnis mit persönlicher Beratung für Eigentümer in München und Landshut.</p>
    </div>
    <div class="seo-preview-grid">
      {locations.map((location) => (
        <a class="seo-preview-card seo-preview-card-link" href={`${base}seo-preview/standorte/${location.id}/`}>
          <span class="seo-preview-kicker">{location.data.office ? 'Bürostandort' : 'Region'}</span>
          <h3>{location.data.title}</h3>
          <p>{location.data.region}</p>
        </a>
      ))}
    </div>
  </section>
</SeoPreviewLayout>
