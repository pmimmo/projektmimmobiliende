---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import SeoPreviewLayout from '../../../layouts/SeoPreviewLayout.astro';
import mapLandshut from '../../../assets/img/map-landshut.png';
import mapMuenchen from '../../../assets/img/map-muenchen.png';

export async function getStaticPaths() {
  const locations = await getCollection('locations');

  return locations
    .filter((location) => location.data.previewPage)
    .map((location) => ({
      params: { id: location.id },
      props: { location },
    }));
}

const { location } = Astro.props;

const [services, people] = await Promise.all([
  getCollection('services'),
  getCollection('people'),
]);

const servicesById = new Map(services.map((service) => [service.id, service.data]));
const peopleById = new Map(people.map((person) => [person.id, person.data]));
const base = import.meta.env.BASE_URL;

const title = `Immobilienmakler und Immobilienbewertung in ${location.data.title}`;
const description = `Projekt M Immobilien begleitet Eigentümer in ${location.data.region} bei Immobilienverkauf, Immobilienbewertung und vertraulichen Immobilienfragen.`;
const locationCopyById = {
  muenchen: {
    eyebrow: 'Immobilienberatung in München',
    introTitle: 'Immobilienentscheidungen in München brauchen Marktkenntnis und Ruhe.',
    intro: 'Der Münchner Immobilienmarkt ist anspruchsvoll, vielfältig und oft emotional. Projekt M Immobilien unterstützt Eigentümer dabei, Wert, Vermarktungsweg und nächsten Schritt sauber einzuordnen.',
    localContext: 'Ob Wohnung, Haus oder Mehrfamilienhaus: In München zählen Lage, Mikrolage, Zustand, Unterlagen und Diskretionswunsch besonders stark zusammen.',
  },
  landshut: {
    eyebrow: 'Immobilienberatung in Landshut',
    introTitle: 'Persönliche Immobilienberatung für Landshut und Umgebung.',
    intro: 'In Landshut und der Region zählt ein gutes Netzwerk ebenso wie eine realistische Einschätzung. Projekt M Immobilien begleitet Eigentümer vertraulich vom ersten Gespräch bis zur nächsten Entscheidung.',
    localContext: 'Gerade bei Verkauf, Erbe oder familiären Veränderungen hilft ein strukturierter Blick auf Wert, Nachfrage und passende Interessenten.',
  },
};
const locationCopy = locationCopyById[location.id as keyof typeof locationCopyById];
const mapByLocation = {
  landshut: mapLandshut,
  muenchen: mapMuenchen,
};
const locationMap = mapByLocation[location.id as keyof typeof mapByLocation];
---

<SeoPreviewLayout
  title={title}
  description={description}
  canonicalPath={`/seo-preview/standorte/${location.id}/`}
  eyebrow={locationCopy?.eyebrow || 'Regionale Immobilienberatung'}
>
  <section class="seo-preview-section">
    <div class="seo-preview-location-intro">
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">{location.data.region}</p>
        <h2>{locationCopy?.introTitle || `Immobilienberatung in ${location.data.title}`}</h2>
        <p>{locationCopy?.intro || `Projekt M Immobilien berät Eigentümer in ${location.data.title} persönlich und vertraulich.`}</p>
        <div class="seo-preview-pill-list">
          {location.data.services.slice(0, 4).map((id) => <span class="seo-preview-pill">{servicesById.get(id)?.shortTitle || servicesById.get(id)?.title || id}</span>)}
        </div>
      </article>
      {locationMap && (
        <div class="seo-preview-location-intro__map">
          <Picture src={locationMap} formats={['avif', 'webp']} alt={`Karte ${location.data.title}`} loading="eager" decoding="async" />
        </div>
      )}
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">Regionaler Markt</p>
        <h2>Warum lokale Erfahrung wichtig ist</h2>
        <p>{locationCopy?.localContext || 'Immobilienentscheidungen hängen immer vom konkreten Objekt, der Lage und der persönlichen Situation ab.'}</p>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Leistungen in {location.data.title}</h2>
      <p>Für Eigentümer stehen Bewertung, Verkauf, Mediation und fachliche Prüfung als persönliche Beratung zur Verfügung.</p>
    </div>
    <dl class="seo-preview-dl">
      <div>
        <dt>Region</dt>
        <dd>{location.data.region}</dd>
      </div>
      <div>
        <dt>Bürostandort</dt>
        <dd>{location.data.office ? 'Ja' : 'Nein, Einzugsgebiet / regionale Zielseite'}</dd>
      </div>
      <div>
        <dt>Leistungen</dt>
        <dd>{location.data.services.map((id) => servicesById.get(id)?.title || id).join(', ')}</dd>
      </div>
      <div>
        <dt>Ansprechpartner</dt>
        <dd>{location.data.relatedPeople.map((id) => peopleById.get(id)?.name || id).join(', ')}</dd>
      </div>
    </dl>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Typische Anliegen in {location.data.title}</h2>
      <p>Viele Eigentümer melden sich nicht mit einer fertigen Entscheidung, sondern mit einer Frage, die zuerst eingeordnet werden muss.</p>
    </div>
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <h3>Leistungen vor Ort</h3>
        <p>Wir prüfen Wert, Unterlagen und Vermarktungsweg, bevor eine Immobilie sichtbar angeboten wird.</p>
      </article>
      <article class="seo-preview-card">
        <h3>Regionale Situationen</h3>
        <p>Erbe, Trennung, Miteigentum oder ein geplanter Verkauf brauchen eine ruhige, fachliche Einordnung.</p>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Passende Ansprechpartner und Themen</h2>
      <p>Je nach Anliegen gelangen Sie direkt zu den relevanten Leistungen und Personen.</p>
    </div>
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <h3>Leistungen in {location.data.title}</h3>
        <ul class="seo-preview-list">
          {location.data.services.map((id) => (
            <li><a href={`${base}seo-preview/leistungen/${id}/`}>{servicesById.get(id)?.title || id}</a></li>
          ))}
        </ul>
      </article>
      <article class="seo-preview-card">
        <h3>Ansprechpartner</h3>
        <ul class="seo-preview-list">
          {location.data.relatedPeople.map((id) => (
            <li><a href={`${base}seo-preview/team/${id}/`}>{peopleById.get(id)?.name || id}</a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <article class="seo-preview-card">
      <p class="seo-preview-kicker">Persönlich sprechen</p>
      <h2>Immobilienanliegen in {location.data.title} besprechen</h2>
      <p>Schildern Sie kurz Ihre Situation. Wir klären vertraulich, ob Bewertung, Verkauf, Mediation oder eine andere Vorbereitung sinnvoll ist.</p>
      <a class="seo-preview-link" href={`${base}#callToAction`}>Kontakt aufnehmen</a>
    </article>
  </section>
</SeoPreviewLayout>
