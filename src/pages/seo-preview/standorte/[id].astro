---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import SeoPreviewLayout from '../../../layouts/SeoPreviewLayout.astro';
import mapLandshut from '../../../assets/img/map-landshut.png';
import mapMuenchen from '../../../assets/img/map-muenchen.png';

export async function getStaticPaths() {
  const locations = await getCollection('locations');

  return locations
    .filter((location) => location.data.previewPage)
    .map((location) => ({
      params: { id: location.id },
      props: { location },
    }));
}

const { location } = Astro.props;

const [services, people] = await Promise.all([
  getCollection('services'),
  getCollection('people'),
]);

const servicesById = new Map(services.map((service) => [service.id, service.data]));
const peopleById = new Map(people.map((person) => [person.id, person.data]));
const base = import.meta.env.BASE_URL;

const title = `Immobilienmakler und Immobilienbewertung in ${location.data.title}`;
const description = `Interne Vorschau für eine Standortseite zu Projekt M Immobilien in ${location.data.region}.`;
const mapByLocation = {
  landshut: mapLandshut,
  muenchen: mapMuenchen,
};
const locationMap = mapByLocation[location.id as keyof typeof mapByLocation];
---

<SeoPreviewLayout
  title={title}
  description={description}
  canonicalPath={`/seo-preview/standorte/${location.id}/`}
  eyebrow={location.data.office ? 'Standortseite Büro' : 'Standortseite Region'}
>
  <section class="seo-preview-section">
    <div class="seo-preview-location-intro">
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">SEO-Aufgabe dieser Seite</p>
        <h2>Lokale Relevanz bündeln</h2>
        <p>Diese Seite soll später erklären, welche Leistungen Projekt M Immobilien in {location.data.title} anbietet und warum die regionale Erfahrung relevant ist.</p>
        <div class="seo-preview-pill-list">
          {location.data.services.slice(0, 4).map((id) => <span class="seo-preview-pill">{servicesById.get(id)?.shortTitle || servicesById.get(id)?.title || id}</span>)}
        </div>
      </article>
      {locationMap && (
        <div class="seo-preview-location-intro__map">
          <Picture src={locationMap} formats={['avif', 'webp']} alt={`Karte ${location.data.title}`} loading="eager" decoding="async" />
        </div>
      )}
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">Local SEO</p>
        <h2>NAP und Leistungsbezug stärken</h2>
        <p>Der Standort soll mit Leistungen, Ansprechpartnern, Google Business Profile und konsistenten Unternehmensdaten verbunden werden.</p>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Standortprofil</h2>
      <p>Der Standort verknüpft regionale Sichtbarkeit mit konkreten Leistungen und Ansprechpartnern.</p>
    </div>
    <dl class="seo-preview-dl">
      <div>
        <dt>Region</dt>
        <dd>{location.data.region}</dd>
      </div>
      <div>
        <dt>Bürostandort</dt>
        <dd>{location.data.office ? 'Ja' : 'Nein, Einzugsgebiet / regionale Zielseite'}</dd>
      </div>
      <div>
        <dt>Leistungen</dt>
        <dd>{location.data.services.map((id) => servicesById.get(id)?.title || id).join(', ')}</dd>
      </div>
      <div>
        <dt>Ansprechpartner</dt>
        <dd>{location.data.relatedPeople.map((id) => peopleById.get(id)?.name || id).join(', ')}</dd>
      </div>
    </dl>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Beispielhafte Inhaltsmodule</h2>
      <p>Die Module schaffen lokale Relevanz, ohne künstliche Stadtteil- oder Keyword-Seiten zu bauen.</p>
    </div>
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <h3>Leistungen vor Ort</h3>
        <p>Immobilienverkauf, Immobilienbewertung, Mediation und Wohnflächenprüfung werden auf den lokalen Kontext bezogen.</p>
      </article>
      <article class="seo-preview-card">
        <h3>Regionale Situationen</h3>
        <p>Erbe, Scheidung, diskreter Verkauf, Gutachten oder Vorbereitung eines Verkaufs können als konkrete Anlässe erklärt werden.</p>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Lokale Verlinkung</h2>
      <p>Von der Standortseite führen Nutzer und Suchmaschinen zu den fachlich passenden Unterseiten.</p>
    </div>
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <h3>Leistungen in {location.data.title}</h3>
        <ul class="seo-preview-list">
          {location.data.services.map((id) => (
            <li><a href={`${base}seo-preview/leistungen/${id}/`}>{servicesById.get(id)?.title || id}</a></li>
          ))}
        </ul>
      </article>
      <article class="seo-preview-card">
        <h3>Ansprechpartner</h3>
        <ul class="seo-preview-list">
          {location.data.relatedPeople.map((id) => (
            <li><a href={`${base}seo-preview/team/${id}/`}>{peopleById.get(id)?.name || id}</a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <article class="seo-preview-card">
      <p class="seo-preview-kicker">Geplanter CTA</p>
      <h2>Immobilienanliegen in {location.data.title} besprechen</h2>
      <p>Der CTA kann später lokal formuliert werden und trotzdem auf denselben zentralen Kontaktprozess einzahlen.</p>
      <a class="seo-preview-link" href={`${base}#callToAction`}>Kontaktbereich der aktuellen Seite ansehen</a>
    </article>
  </section>
</SeoPreviewLayout>
