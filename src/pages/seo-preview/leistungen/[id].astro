---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import SeoPreviewLayout from '../../../layouts/SeoPreviewLayout.astro';
import bannerOper from '../../../assets/img/banner-oper-erweitert.jpg';
import dekraSeal from '../../../assets/img/DekraImmobilienbewertungD1.png';
import portraitNeuer from '../../../assets/img/portrait-neuer.jpg';

export async function getStaticPaths() {
  const services = await getCollection('services');

  return services
    .filter((service) => service.data.previewPage)
    .map((service) => ({
      params: { id: service.id },
      props: { service },
    }));
}

const { service } = Astro.props;

const [certifications, people, locations] = await Promise.all([
  getCollection('certifications'),
  getCollection('people'),
  getCollection('locations'),
]);

const certificationsById = new Map(certifications.map((certification) => [certification.id, certification.data]));
const peopleById = new Map(people.map((person) => [person.id, person.data]));
const locationsById = new Map(locations.map((location) => [location.id, location.data]));
const base = import.meta.env.BASE_URL;

const title = service.data.title;
const description = service.data.primarySearchIntent;

const serviceDrafts = {
  immobilienbewertung: {
    intro: 'Für Eigentümer, Erbengemeinschaften oder Verkaufsentscheidungen ist eine belastbare Immobilienbewertung oft der erste sinnvolle Schritt. Die Seite sollte klar zwischen schneller Einschätzung, Marktwert und fachlich begründetem Gutachten unterscheiden.',
    situations: ['Verkaufsvorbereitung mit realistischer Preisfindung', 'Erbe, Nachlass oder Vermögensauseinandersetzung', 'Scheidung, Miteigentum oder strittige Wertfragen', 'Plausibilisierung einer vorhandenen Bewertung'],
    process: ['Anliegen und Bewertungszweck klären', 'Objektunterlagen und Lage einordnen', 'Besichtigung und fachliche Prüfung', 'Ergebnis verständlich besprechen'],
    cta: 'Immobilienwert fachlich einschätzen lassen',
  },
  immobilienverkauf: {
    intro: 'Beim Verkauf steht nicht die öffentliche Menge an Inseraten im Vordergrund, sondern ein sauber vorbereiteter, diskreter und nachvollziehbarer Prozess. Die Seite sollte erklären, warum gerade nicht jedes Objekt öffentlich gezeigt werden muss.',
    situations: ['Diskreter Verkauf ohne breite öffentliche Vermarktung', 'Verkauf nach Bewertung oder Gutachten', 'Verkauf im Zusammenhang mit Erbe oder Veränderung', 'Auswahl passender Interessenten statt maximaler Sichtbarkeit'],
    process: ['Ziel, Zeitrahmen und Diskretionsgrad klären', 'Objekt und Unterlagen vorbereiten', 'Vermarktungsweg bewusst festlegen', 'Gespräche, Prüfung und Abschluss begleiten'],
    cta: 'Diskreten Immobilienverkauf besprechen',
  },
  immobilienmediation: {
    intro: 'Immobilienkonflikte brauchen oft zuerst Struktur, bevor über Verkauf, Bewertung oder Aufteilung entschieden werden kann. Die Seite sollte Projekt M als neutrale, fachlich versierte Begleitung positionieren.',
    situations: ['Erbengemeinschaften mit unterschiedlichen Interessen', 'Trennung oder Scheidung mit gemeinsamer Immobilie', 'Miteigentümer mit blockierten Entscheidungen', 'Konflikte vor Verkauf, Bewertung oder Nutzung'],
    process: ['Konfliktlage vertraulich einordnen', 'Beteiligte und Entscheidungsfragen strukturieren', 'Optionen sachlich vorbereiten', 'Nächsten Schritt gemeinsam festlegen'],
    cta: 'Immobilienkonflikt vertraulich einordnen',
  },
};

const draft = serviceDrafts[service.id as keyof typeof serviceDrafts];
const serviceImageById = {
  immobilienbewertung: dekraSeal,
  immobilienverkauf: bannerOper,
  immobilienmediation: portraitNeuer,
  wohnflaechenberechnung: dekraSeal,
};
const serviceImage = serviceImageById[service.id as keyof typeof serviceImageById];
---

<SeoPreviewLayout
  title={title}
  description={description}
  canonicalPath={`/seo-preview/leistungen/${service.id}/`}
  eyebrow="Leistungsseite Vorschau"
>
  <section class="seo-preview-section">
    <div class="seo-preview-split">
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">Seitenentwurf</p>
        <h2>{draft?.cta || service.data.title}</h2>
        <p>{draft?.intro || 'Diese Seite soll später eine konkrete Eigentümerfrage beantworten und daraus zur Kontaktaufnahme führen.'}</p>
        <div class="seo-preview-actions">
          <a class="button" href={`${base}#callToAction`}>Kontakt aufnehmen</a>
          <a class="seo-preview-secondary-link" href={`${base}seo-preview/leistungen/`}>Alle Leistungen</a>
        </div>
      </article>
      <article class="seo-preview-media-card">
        <div class="seo-preview-media-card__image">
          {serviceImage && <Picture src={serviceImage} formats={['avif', 'webp']} alt="" loading="eager" decoding="async" />}
        </div>
        <div class="seo-preview-media-card__body">
          <p class="seo-preview-eyebrow">SEO/GEO-Aufgabe</p>
          <h2>Konkrete Suchintention</h2>
          <p>{service.data.primarySearchIntent}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Typische Situationen</h2>
      <p>Dieser Block macht aus einer abstrakten Leistung eine Seite für konkrete Eigentümeranliegen.</p>
    </div>
    <div class="seo-preview-grid seo-preview-grid--two">
      <article class="seo-preview-card">
        <h3>Für wen ist das relevant?</h3>
        <ul class="seo-preview-check-list">
          {(draft?.situations || ['Eigentümer mit konkretem Beratungsbedarf']).map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="seo-preview-card">
        <h3>Wie Projekt M vorgeht</h3>
        <ul class="seo-preview-check-list">
          {(draft?.process || ['Anliegen klären', 'Situation fachlich einordnen', 'Nächsten Schritt festlegen']).map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Leistungsprofil</h2>
      <p>Diese Basisdaten steuern später Navigation, interne Links, strukturierte Daten und passende Vertrauenssignale.</p>
    </div>
    <dl class="seo-preview-dl">
      <div>
        <dt>Status</dt>
        <dd>{service.data.status === 'active' ? 'Aktiv' : 'Geplant'}</dd>
      </div>
      <div>
        <dt>Standorte</dt>
        <dd>{service.data.locations.map((id) => locationsById.get(id)?.title || id).join(', ')}</dd>
      </div>
      <div>
        <dt>Ansprechpartner</dt>
        <dd>{service.data.relatedPeople.map((id) => peopleById.get(id)?.name || id).join(', ') || 'Noch nicht zugeordnet'}</dd>
      </div>
      <div>
        <dt>Relevante Zertifizierungen</dt>
        <dd>{service.data.relatedCertifications.map((id) => certificationsById.get(id)?.title || id).join(', ') || 'Keine direkte Zuordnung'}</dd>
      </div>
    </dl>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Interne Verlinkung</h2>
      <p>Jede Leistungsseite soll Personen, Standorte und Kompetenzsignale miteinander verbinden.</p>
    </div>
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <h3>Ansprechpartner</h3>
        <ul class="seo-preview-list">
          {service.data.relatedPeople.map((id) => (
            <li><a href={`${base}seo-preview/team/${id}/`}>{peopleById.get(id)?.name || id}</a></li>
          ))}
        </ul>
      </article>
      <article class="seo-preview-card">
        <h3>Standorte</h3>
        <ul class="seo-preview-list">
          {service.data.locations.map((id) => (
            <li><a href={`${base}seo-preview/standorte/${id}/`}>{locationsById.get(id)?.title || id}</a></li>
          ))}
        </ul>
      </article>
      <article class="seo-preview-card">
        <h3>Zertifikate und Siegel</h3>
        <ul class="seo-preview-list">
          {service.data.relatedCertifications.map((id) => (
            <li><a href={`${base}seo-preview/zertifikate/${id}/`}>{certificationsById.get(id)?.title || id}</a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <article class="seo-preview-card">
      <p class="seo-preview-kicker">Geplanter CTA</p>
      <h2>Beratung ohne öffentliches Objekt-Schaufenster</h2>
      <p>Der CTA sollte zur Boutique-Positionierung passen: diskret, fachlich und persönlich statt portalartig.</p>
      <a class="seo-preview-link" href={`${base}#callToAction`}>Kontaktbereich der aktuellen Seite ansehen</a>
    </article>
  </section>
</SeoPreviewLayout>
