---
import { getCollection } from 'astro:content';
import SeoPreviewLayout from '../../../layouts/SeoPreviewLayout.astro';

const base = import.meta.env.BASE_URL;
const services = (await getCollection('services'))
  .filter((service) => service.data.previewPage)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'));
---

<SeoPreviewLayout
  title="Leistungen"
  description="Vorschau der künftigen Leistungsnavigation: Immobilienverkauf, Immobilienbewertung und Immobilienmediation als eigenständige Such- und Beratungsseiten."
  canonicalPath="/seo-preview/leistungen/"
  eyebrow="Bereichsseite"
>
  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Warum eigene Leistungsseiten?</h2>
      <p>Jede Leistung hat eine eigene Suchintention, eigene Vertrauenssignale und eigene Kontaktmotivation.</p>
    </div>
    <div class="seo-preview-grid">
      {services.map((service) => (
        <a class="seo-preview-card seo-preview-card-link" href={`${base}seo-preview/leistungen/${service.id}/`}>
          <span class="seo-preview-kicker">{service.data.shortTitle || 'Leistung'}</span>
          <h3>{service.data.title}</h3>
          <p>{service.data.primarySearchIntent}</p>
        </a>
      ))}
    </div>
  </section>
</SeoPreviewLayout>
