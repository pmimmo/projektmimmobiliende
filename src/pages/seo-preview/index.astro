---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import SeoPreviewLayout from '../../layouts/SeoPreviewLayout.astro';
import portraitNeuer from '../../assets/img/portrait-neuer-1zu1.jpg';
import dekraSeal from '../../assets/img/DekraImmobilienbewertungD1.png';

const base = import.meta.env.BASE_URL;

const [people, services, locations, certifications] = await Promise.all([
  getCollection('people'),
  getCollection('services'),
  getCollection('locations'),
  getCollection('certifications'),
]);

const visibleServices = services.filter((service) => service.data.previewPage);
const visibleLocations = locations.filter((location) => location.data.previewPage);
const visiblePeople = people.filter((person) => person.data.showDetailPage);
const personalCertifications = certifications.filter((certification) => certification.data.belongsTo.length > 0);
const primaryServices = visibleServices.filter((service) => ['immobilienverkauf', 'immobilienbewertung', 'immobilienmediation'].includes(service.id));
---

<SeoPreviewLayout
  title="Neue Website-Struktur"
  description="Interne Vorschau, wie Projekt M Immobilien künftig mit Startseite, Leistungsseiten, Standortseiten, Teamprofilen und Kompetenzseiten aufgebaut sein könnte."
  canonicalPath="/seo-preview/"
  eyebrow="Strategische Vorschau"
  heroVariant="home"
>
  <section class="seo-preview-section">
    <div class="seo-preview-highlight">
      <div class="seo-preview-highlight__media">
        <Picture src={portraitNeuer} formats={['avif', 'webp']} alt="Rüdiger Neuer" loading="lazy" decoding="async" />
      </div>
      <div class="seo-preview-highlight__text">
        <p class="seo-preview-eyebrow">Startseiten-Entwurf</p>
        <h2>Diskret verkaufen, belastbar bewerten, persönlich beraten lassen.</h2>
        <p class="lead">Die neue Startseite sollte nicht wie ein Immobilienportal wirken. Sie sollte sofort erklären, dass Projekt M Immobilien für Eigentümer arbeitet, die fachliche Einschätzung und vertrauliche Begleitung suchen.</p>
        <div class="seo-preview-actions">
          <a class="button" href={`${base}seo-preview/leistungen/immobilienverkauf/`}>Immobilie verkaufen</a>
          <a class="seo-preview-secondary-link" href={`${base}seo-preview/leistungen/immobilienbewertung/`}>Bewertung prüfen</a>
        </div>
      </div>
      <div class="seo-preview-highlight__badge">
        <Picture src={dekraSeal} formats={['avif', 'webp']} alt="DEKRA zertifizierter Sachverständiger Immobilienbewertung D1" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="seo-preview-band seo-preview-band--gray">
    <div class="seo-preview-section-header">
      <h2>Direkte Wege für Eigentümer</h2>
      <p>Diese drei Einstiege sollten auf der Startseite deutlich weiter oben sichtbar sein als eine vollständige Leistungsauflistung.</p>
    </div>
    <div class="seo-preview-feature-tiles">
      {primaryServices.map((service) => (
        <a class="seo-preview-feature-tile" href={`${base}seo-preview/leistungen/${service.id}/`}>
          <span class="seo-preview-kicker">{service.data.shortTitle || 'Leistung'}</span>
          <h3>{service.data.title}</h3>
          <p>{service.data.primarySearchIntent}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-statement">
      <div class="seo-preview-statement__copy">
        <p class="seo-preview-eyebrow">Boutique statt Objektportal</p>
        <h2>Diskretion wird als Stärke sichtbar, nicht als fehlender Objektbestand.</h2>
        <p>Die spätere Startseite sollte klar sagen, warum keine öffentlichen Immobilienangebote im Mittelpunkt stehen: Projekt M Immobilien verkauft vertraulich, persönlich und mit fachlicher Vorprüfung.</p>
      </div>
      <aside class="seo-preview-statement__note">
        <p class="seo-preview-kicker">Warum so?</p>
        <h3>Die Startseite soll Entscheidungen führen</h3>
        <p>Besucher kommen meist mit einem konkreten Anlass: Verkauf, Bewertung, Konflikt oder Standortsuche. Die neue Struktur macht diese Wege sichtbar.</p>
      </aside>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Regionale und fachliche Signale</h2>
      <p>Die Startseite sollte nach den Hauptwegen Vertrauen und lokale Relevanz aufbauen.</p>
    </div>
    <div class="seo-preview-grid">
      <a class="seo-preview-card seo-preview-card-link" href={`${base}seo-preview/standorte/`}>
        <span class="seo-preview-kicker">Standorte</span>
        <h3>München und Landshut</h3>
        <p>{visibleLocations.length} lokale Einstiegsseiten für regionale Sichtbarkeit.</p>
      </a>
      <a class="seo-preview-card seo-preview-card-link" href={`${base}seo-preview/team/`}>
        <span class="seo-preview-kicker">Team</span>
        <h3>Personen und Expertise</h3>
        <p>{visiblePeople.length} Personenprofile mit Leistungs- und Zertifikatsbezug.</p>
      </a>
      <a class="seo-preview-card seo-preview-card-link" href={`${base}seo-preview/zertifikate/`}>
        <span class="seo-preview-kicker">Kompetenzen</span>
        <h3>Zertifikate und Siegel</h3>
        <p>{personalCertifications.length} direkt zugeordnete Qualifikationssignale.</p>
      </a>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Vorgeschlagener Startseitenfluss</h2>
      <p>Das ist die Reihenfolge, in der ich die spätere Live-Startseite umbauen würde.</p>
    </div>
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <h3>1. Positionierung</h3>
        <p>Boutique-Makler, diskrete Vermittlung, belastbare Bewertung, München und Landshut.</p>
      </article>
      <article class="seo-preview-card">
        <h3>2. Nutzerwege</h3>
        <p>Verkaufen, bewerten lassen, Konflikt lösen. Jeder Weg führt auf eine starke Unterseite.</p>
      </article>
      <article class="seo-preview-card">
        <h3>3. Vertrauen</h3>
        <p>Rüdiger Neuer, Zertifizierungen, Mitgliedschaften, Bewertungen und klare Zuständigkeit.</p>
      </article>
      <article class="seo-preview-card">
        <h3>4. Kontakt</h3>
        <p>Persönliche Erstberatung statt Objektkatalog. Das passt besser zum Geschäftsmodell.</p>
      </article>
    </div>
  </section>
</SeoPreviewLayout>
