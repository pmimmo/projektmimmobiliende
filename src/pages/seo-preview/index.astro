---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import SeoPreviewLayout from '../../layouts/SeoPreviewLayout.astro';
import portraitNeuer from '../../assets/img/portrait-neuer-1zu1.jpg';
import dekraSeal from '../../assets/img/DekraImmobilienbewertungD1.png';

const base = import.meta.env.BASE_URL;

const [people, services, certifications] = await Promise.all([
  getCollection('people'),
  getCollection('services'),
  getCollection('certifications'),
]);

const visibleServices = services.filter((service) => service.data.previewPage);
const visiblePeople = people.filter((person) => person.data.showDetailPage);
const personalCertifications = certifications.filter((certification) => certification.data.belongsTo.length > 0);
const primaryServices = visibleServices.filter((service) => ['immobilienverkauf', 'immobilienbewertung', 'immobilienmediation'].includes(service.id));
---

<SeoPreviewLayout
  title="Projekt M Immobilien"
  description="Ihr Immobilienmakler für München und Landshut: diskrete Immobilienvermittlung, fundierte Immobilienbewertung und persönliche Beratung durch erfahrene Ansprechpartner."
  canonicalPath="/seo-preview/"
  eyebrow="Immobilienmakler in München und Landshut"
  heroVariant="home"
>
  <section class="seo-preview-section">
    <div class="seo-preview-highlight">
      <div class="seo-preview-highlight__media">
        <Picture src={portraitNeuer} formats={['avif', 'webp']} alt="Rüdiger Neuer" loading="lazy" decoding="async" />
      </div>
      <div class="seo-preview-highlight__text">
        <p class="seo-preview-eyebrow">Persönlich. Fachlich. Diskret.</p>
        <h2>Diskret verkaufen, belastbar bewerten, persönlich beraten lassen.</h2>
        <p class="lead">Projekt M Immobilien begleitet Eigentümer, Erbengemeinschaften und Familien bei Entscheidungen rund um Immobilien in München und Landshut. Im Mittelpunkt stehen eine realistische Einschätzung, ein sauber vorbereiteter Prozess und vertrauliche Gespräche statt öffentlicher Massenvermarktung.</p>
        <div class="seo-preview-actions">
          <a class="button" href={`${base}seo-preview/leistungen/immobilienverkauf/`}>Immobilie verkaufen</a>
          <a class="seo-preview-secondary-link" href={`${base}seo-preview/leistungen/immobilienbewertung/`}>Immobilie bewerten lassen</a>
        </div>
      </div>
      <div class="seo-preview-highlight__badge">
        <Picture src={dekraSeal} formats={['avif', 'webp']} alt="DEKRA zertifizierter Sachverständiger Immobilienbewertung D1" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="seo-preview-band seo-preview-band--gray">
    <div class="seo-preview-section-header">
      <h2>Wobei wir Sie unterstützen</h2>
      <p>Ob Verkauf, Bewertung oder Konfliktsituation: Sie sprechen direkt mit erfahrenen Ansprechpartnern, die Ihre Immobilie und Ihre Entscheidungssituation ernst nehmen.</p>
    </div>
    <div class="seo-preview-feature-tiles">
      {primaryServices.map((service) => (
        <a class="seo-preview-feature-tile" href={`${base}seo-preview/leistungen/${service.id}/`}>
          <span class="seo-preview-kicker">{service.data.shortTitle || 'Leistung'}</span>
          <h3>{service.data.title}</h3>
          <p>{service.data.primarySearchIntent}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-statement">
      <div class="seo-preview-statement__copy">
        <p class="seo-preview-eyebrow">Boutique statt Objektportal</p>
        <h2>Nicht jede Immobilie gehört sofort ins öffentliche Schaufenster.</h2>
        <p>Viele Eigentümer wünschen zuerst eine vertrauliche Einschätzung: Was ist realistisch? Welche Unterlagen fehlen? Wie sichtbar soll die Immobilie werden? Projekt M Immobilien steht für einen bewussten Vermittlungsweg, bei dem Diskretion, Qualität der Interessenten und ein belastbarer Wertansatz zusammengehören.</p>
      </div>
      <aside class="seo-preview-statement__note">
        <p class="seo-preview-kicker">Unser Ansatz</p>
        <h3>Erst verstehen, dann vermitteln</h3>
        <p>Wir klären Ziel, Zeitrahmen, Bewertungsgrundlage und Diskretionswunsch, bevor wir über Vermarktung sprechen. So entsteht ein Prozess, der zur Immobilie und zu den beteiligten Menschen passt.</p>
      </aside>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Regionale Nähe und geprüfte Kompetenz</h2>
      <p>Projekt M Immobilien verbindet lokale Marktkenntnis in München und Landshut mit zertifizierter Bewertungs- und Vermittlungskompetenz.</p>
    </div>
    <div class="seo-preview-grid">
      <a class="seo-preview-card seo-preview-card-link" href={`${base}seo-preview/standorte/`}>
        <span class="seo-preview-kicker">Standorte</span>
        <h3>München und Landshut</h3>
        <p>Beratung für Eigentümer in München, Landshut und der jeweiligen Umgebung.</p>
      </a>
      <a class="seo-preview-card seo-preview-card-link" href={`${base}seo-preview/team/`}>
        <span class="seo-preview-kicker">Team</span>
        <h3>Persönliche Ansprechpartner</h3>
        <p>{visiblePeople.length} Profile mit klarer Zuständigkeit für Bewertung, Vermittlung und regionale Beratung.</p>
      </a>
      <a class="seo-preview-card seo-preview-card-link" href={`${base}seo-preview/zertifikate/`}>
        <span class="seo-preview-kicker">Kompetenzen</span>
        <h3>Zertifikate und Siegel</h3>
        <p>{personalCertifications.length} Qualifikations- und Vertrauenssignale, verständlich erklärt und Personen zugeordnet.</p>
      </a>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Der nächste Schritt</h2>
      <p>Ein gutes Gespräch beginnt nicht mit einem Formular, sondern mit einer ehrlichen Einordnung Ihrer Situation.</p>
    </div>
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <h3>Immobilie verkaufen</h3>
        <p>Wir bereiten Verkauf, Unterlagen, Wertansatz und Vermarktungsweg strukturiert vor.</p>
      </article>
      <article class="seo-preview-card">
        <h3>Immobilie bewerten</h3>
        <p>Sie erhalten eine fachliche Einschätzung als Grundlage für Verkauf, Erbe, Trennung oder Vermögensfragen.</p>
      </article>
      <article class="seo-preview-card">
        <h3>Konflikte lösen</h3>
        <p>Bei Erbengemeinschaft, Trennung oder Miteigentum helfen wir, Optionen sachlich zu sortieren.</p>
      </article>
      <article class="seo-preview-card">
        <h3>Persönlich sprechen</h3>
        <p>Wir klären vertraulich, welcher nächste Schritt für Ihre Immobilie sinnvoll ist.</p>
      </article>
    </div>
  </section>
</SeoPreviewLayout>
