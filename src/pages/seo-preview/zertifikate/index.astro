---
import { getCollection } from 'astro:content';
import SeoPreviewLayout from '../../../layouts/SeoPreviewLayout.astro';

const base = import.meta.env.BASE_URL;
const certifications = (await getCollection('certifications'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'));
---

<SeoPreviewLayout
  title="Kompetenzen, Zertifikate und Siegel"
  description="Vorschau der künftigen Kompetenzstruktur: Zertifizierungen, Mitgliedschaften und Plattform-Siegel werden erklärbar und intern verlinkbar."
  canonicalPath="/seo-preview/zertifikate/"
  eyebrow="Bereichsseite"
>
  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Vertrauenssignale erklären</h2>
      <p>Siegel sollen nicht nur Logos sein. Sie sollen verständlich machen, welche Qualifikation oder Zugehörigkeit dahintersteht.</p>
    </div>
    <div class="seo-preview-grid">
      {certifications.map((certification) => (
        <a class="seo-preview-card seo-preview-card-link" href={`${base}seo-preview/zertifikate/${certification.id}/`}>
          <span class="seo-preview-kicker">{certification.data.category}</span>
          <h3>{certification.data.title}</h3>
          <p>{certification.data.issuer || 'Projekt M Immobilien'}</p>
        </a>
      ))}
    </div>
  </section>
</SeoPreviewLayout>
