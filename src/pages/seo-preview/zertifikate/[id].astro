---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import SeoPreviewLayout from '../../../layouts/SeoPreviewLayout.astro';
import dekraD1 from '../../../assets/img/DekraImmobilienbewertungD1.png';
import diaAbsolvent from '../../../assets/img/DiaAbsolvent.jpeg';
import diaZertMakler from '../../../assets/img/DIAZertMakler.png';
import diaZertS from '../../../assets/img/DIAZertSrnSmall-ohneSchatten.png';
import hausGrund from '../../../assets/img/haus+grund.png';
import immoscout24Silber from '../../../assets/img/immoscout24SilberPartnerSeit2025.png';
import immoweltPremium from '../../../assets/img/immoWeltPremiumPartner.png';
import ivd from '../../../assets/img/mitgliedImIvd.png';
import ivdMarktforschung from '../../../assets/img/2026 - Siegel Partner-Marktforschung ivd schmal.png';
import ivdWeiterbildung from '../../../assets/img/IVD_2025.png';
import sprengnetterBesichtiger from '../../../assets/img/SprengnetterImmoBesichtiger-Schadenerkennung.png';
import sprengnetterMediator from '../../../assets/img/SpregnetterImmoMediator.png';
import sprengnetterWert from '../../../assets/img/SprengnetterGesicherterImmobilienwert-3D.png';
import vdiv from '../../../assets/img/vdivImmobilienverwalterBayern.png';

export async function getStaticPaths() {
  const certifications = await getCollection('certifications');

  return certifications.map((certification) => ({
    params: { id: certification.id },
    props: { certification },
  }));
}

const { certification } = Astro.props;

const people = await getCollection('people');
const peopleById = new Map(people.map((person) => [person.id, person.data]));
const base = import.meta.env.BASE_URL;
const belongsTo = certification.data.belongsTo
  .map((id) => peopleById.get(id)?.name || id)
  .join(', ') || certification.data.holder || 'Projekt M Immobilien';

const title = certification.data.title;
const description = certification.data.desc;
const certificationImageById = {
  'dekra-d1': dekraD1,
  'dia-absolvent': diaAbsolvent,
  'dia-zert-din15733': diaZertMakler,
  'dia-zert-dipl-sach': diaZertS,
  'dia-zert-s': diaZertS,
  din15733: diaZertMakler,
  hausgrund: hausGrund,
  'immoscout24-silber': immoscout24Silber,
  'immowelt-premium': immoweltPremium,
  ivd,
  'ivd-marktforschung': ivdMarktforschung,
  'ivd-weiterbildung': ivdWeiterbildung,
  'sprengnetter-immobesichtiger': sprengnetterBesichtiger,
  'sprengnetter-immomediator': sprengnetterMediator,
  'sprengnetter-immowert': sprengnetterWert,
  vdiv,
};
const certificationImage = certificationImageById[certification.id as keyof typeof certificationImageById];
---

<SeoPreviewLayout
  title={title}
  description={description}
  canonicalPath={`/seo-preview/zertifikate/${certification.id}/`}
  eyebrow="Zertifikat / Siegel Vorschau"
>
  <section class="seo-preview-section">
    <div class="seo-preview-split">
      <article class="seo-preview-media-card">
        <div class="seo-preview-media-card__image">
          {certificationImage ? (
            <Picture src={certificationImage} formats={['avif', 'webp']} alt={certification.data.title} loading="eager" decoding="async" />
          ) : (
            <strong>{certification.data.issuer || 'Projekt M Immobilien'}</strong>
          )}
        </div>
        <div class="seo-preview-media-card__body">
          <p class="seo-preview-kicker">{certification.data.category}</p>
          <h2>{certification.data.issuer || 'Projekt M Immobilien'}</h2>
          <p>{belongsTo}</p>
        </div>
      </article>
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">SEO-Aufgabe dieser Seite</p>
        <h2>Vertrauenssignal erklärbar machen</h2>
        <p>Diese Detailseite kann später erklären, was ein Siegel bedeutet, von wem es stammt und ob es einer Person oder dem Unternehmen zugeordnet ist.</p>
      </article>
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">Nutzung im Frontend</p>
        <h2>Quelle für Popover und Detailseite</h2>
        <p>Dieselbe Collection kann kurze Popover-Texte und ausführlichere Zertifikatsseiten speisen.</p>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Einordnung</h2>
      <p>Zertifikate und Siegel sollen nicht nur Logos sein, sondern als nachvollziehbare Vertrauenssignale erklärt werden.</p>
    </div>
    <dl class="seo-preview-dl">
      <div>
        <dt>Kategorie</dt>
        <dd>{certification.data.category}</dd>
      </div>
      <div>
        <dt>Herausgeber</dt>
        <dd>{certification.data.issuer || 'Noch nicht hinterlegt'}</dd>
      </div>
      <div>
        <dt>Zuordnung</dt>
        <dd>{belongsTo}</dd>
      </div>
      <div>
        <dt>Auf Startseite sichtbar</dt>
        <dd>{certification.data.visibleOnStartPage ? 'Ja' : 'Nein'}</dd>
      </div>
      {certification.data.link && (
        <div>
          <dt>Externer Link</dt>
          <dd><a href={certification.data.link}>{certification.data.link}</a></dd>
        </div>
      )}
    </dl>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Erklärung</h2>
      <p>Diese Erklärung kann später direkt im Popover und auf Detailseiten verwendet werden.</p>
    </div>
    <article class="seo-preview-card">
      <p>{certification.data.desc}</p>
    </article>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Zuordnung</h2>
      <p>Wichtig für Vertrauen und AI Search: klar benennen, ob das Signal zur Person oder zur Firma gehört.</p>
    </div>
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <h3>Gehört zu</h3>
        <div class="seo-preview-pill-list">
          {
            certification.data.belongsTo.length
              ? certification.data.belongsTo.map((id) => (
                  <a class="seo-preview-pill" href={`${base}seo-preview/team/${id}/`}>{peopleById.get(id)?.name || id}</a>
                ))
              : <span class="seo-preview-pill">Projekt M Immobilien</span>
          }
        </div>
      </article>
      <article class="seo-preview-card">
        <h3>Nächste Nutzung</h3>
        <p>Dieses Zertifikat kann in Teamprofilen, Leistungsseiten und auf der Startseite aus derselben Datenquelle angezeigt werden.</p>
      </article>
    </div>
  </section>
</SeoPreviewLayout>
