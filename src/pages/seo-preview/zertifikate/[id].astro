---
import { getCollection } from 'astro:content';
import SeoPreviewLayout from '../../../layouts/SeoPreviewLayout.astro';

export async function getStaticPaths() {
  const certifications = await getCollection('certifications');

  return certifications.map((certification) => ({
    params: { id: certification.id },
    props: { certification },
  }));
}

const { certification } = Astro.props;

const people = await getCollection('people');
const peopleById = new Map(people.map((person) => [person.id, person.data]));
const base = import.meta.env.BASE_URL;
const belongsTo = certification.data.belongsTo
  .map((id) => peopleById.get(id)?.name || id)
  .join(', ') || certification.data.holder || 'Projekt M Immobilien';

const title = certification.data.title;
const description = certification.data.desc;
---

<SeoPreviewLayout
  title={title}
  description={description}
  canonicalPath={`/seo-preview/zertifikate/${certification.id}/`}
  eyebrow="Zertifikat / Siegel Vorschau"
>
  <section class="seo-preview-section">
    <div class="seo-preview-grid">
      <article class="seo-preview-card seo-preview-card--dark">
        <p class="seo-preview-eyebrow">SEO-Aufgabe dieser Seite</p>
        <h2>Vertrauenssignal erklärbar machen</h2>
        <p>Diese Detailseite kann später erklären, was ein Siegel bedeutet, von wem es stammt und ob es einer Person oder dem Unternehmen zugeordnet ist.</p>
      </article>
      <article class="seo-preview-card">
        <p class="seo-preview-eyebrow">Nutzung im Frontend</p>
        <h2>Quelle für Popover und Detailseite</h2>
        <p>Dieselbe Collection kann kurze Popover-Texte und ausführlichere Zertifikatsseiten speisen.</p>
      </article>
    </div>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Einordnung</h2>
      <p>Zertifikate und Siegel sollen nicht nur Logos sein, sondern als nachvollziehbare Vertrauenssignale erklärt werden.</p>
    </div>
    <dl class="seo-preview-dl">
      <div>
        <dt>Kategorie</dt>
        <dd>{certification.data.category}</dd>
      </div>
      <div>
        <dt>Herausgeber</dt>
        <dd>{certification.data.issuer || 'Noch nicht hinterlegt'}</dd>
      </div>
      <div>
        <dt>Zuordnung</dt>
        <dd>{belongsTo}</dd>
      </div>
      <div>
        <dt>Auf Startseite sichtbar</dt>
        <dd>{certification.data.visibleOnStartPage ? 'Ja' : 'Nein'}</dd>
      </div>
      {certification.data.link && (
        <div>
          <dt>Externer Link</dt>
          <dd><a href={certification.data.link}>{certification.data.link}</a></dd>
        </div>
      )}
    </dl>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Erklärung</h2>
      <p>Diese Erklärung kann später direkt im Popover und auf Detailseiten verwendet werden.</p>
    </div>
    <article class="seo-preview-card">
      <p>{certification.data.desc}</p>
    </article>
  </section>

  <section class="seo-preview-section">
    <div class="seo-preview-section-header">
      <h2>Zuordnung</h2>
      <p>Wichtig für Vertrauen und AI Search: klar benennen, ob das Signal zur Person oder zur Firma gehört.</p>
    </div>
    <div class="seo-preview-grid">
      <article class="seo-preview-card">
        <h3>Gehört zu</h3>
        <div class="seo-preview-pill-list">
          {
            certification.data.belongsTo.length
              ? certification.data.belongsTo.map((id) => (
                  <a class="seo-preview-pill" href={`${base}seo-preview/team/${id}/`}>{peopleById.get(id)?.name || id}</a>
                ))
              : <span class="seo-preview-pill">Projekt M Immobilien</span>
          }
        </div>
      </article>
      <article class="seo-preview-card">
        <h3>Nächste Nutzung</h3>
        <p>Dieses Zertifikat kann in Teamprofilen, Leistungsseiten und auf der Startseite aus derselben Datenquelle angezeigt werden.</p>
      </article>
    </div>
  </section>
</SeoPreviewLayout>
