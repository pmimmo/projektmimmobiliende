---
import { Picture } from 'astro:assets';
import xmasBg from '../assets/img/pexels-george-dolgikh-1303094-blur.jpg';
import banners from '../data/banners.json';

const { xmas } = banners;
const now = new Date();
const currentYear = now.getFullYear();

// Xmas spans Dec–Jan across year boundary
const startMonth = parseInt(xmas.start.split('-')[0], 10);
const startDay = parseInt(xmas.start.split('-')[1], 10);
const endMonth = parseInt(xmas.end.split('-')[0], 10);
const endDay = parseInt(xmas.end.split('-')[1], 10);

// Determine if we're in the Dec portion or the Jan portion
let start: Date;
let end: Date;

if (now.getMonth() + 1 >= startMonth) {
  // We're in Dec (or later in the start year)
  start = new Date(currentYear, startMonth - 1, startDay, 0, 0, 0);
  end = new Date(currentYear + 1, endMonth - 1, endDay, 23, 59, 59);
} else {
  // We're in Jan (in the end year)
  start = new Date(currentYear - 1, startMonth - 1, startDay, 0, 0, 0);
  end = new Date(currentYear, endMonth - 1, endDay, 23, 59, 59);
}

const isActive = now >= start && now <= end;
---
{isActive && (
  <aside id="weihnachten-neujahr" class="xmas-box" aria-labelledby="xmas-heading">
    <div class="container">
      <h2 id="xmas-heading" class="sr-only">Erholsame Feiertage und ein schönen Jahreswechsel</h2>
      <div class="xmas-content scale-up">
        <Picture src={xmasBg} formats={['avif', 'webp']} alt="" class="bg-cover" style="object-position: center bottom;" loading="lazy" decoding="async" />
        <p>Liebe Kunden der Projekt M Immobilien,</p>
        <p>Für die bevorstehenden Weihnachtsfeiertage wünschen wir Ihnen und Ihrer Familie eine erholsame und besinnliche Zeit.</p>
        <p>Wir bedanken uns für das uns entgegengebrachte Vertrauen und wünschen Ihnen einen mit Zuversicht erfüllten Jahreswechsel und von Herzen ein gesundes und friedvolles Jahr&nbsp;2026.</p>
        <p>Auch wir freuen uns ab dem 22.&nbsp;Dezember 2025 auf die gemeinsame Zeit mit unseren Familien.</p>
        <p>Ab dem 7. Januar sind wir gerne wieder für Sie und Ihre Anliegen da.</p>
      </div>
    </div>
  </aside>
)}

<style>
  #weihnachten-neujahr .xmas-content {
    border-radius: 2rem;
    background-color: #f8f8f8;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 4rem 2rem 17rem 2rem;
    color: rgb(169, 49, 73);
    font-size: 1.3rem;
    font-weight: 600;
    text-shadow: 0px 0px 8px rgba(255, 255, 255, 0.9);
    box-shadow:
    -4px -4px 6px -4px white inset,
    4px 4px 6px -4px white inset,
    0 0 0 1px rgba(169, 49, 73,.15),
    0 -8px 8px 0 rgba(0,0,0,0.025) inset,
    0  8px 8px 0 rgba(0,0,0,0.025) inset;
  }

  #weihnachten-neujahr .xmas-content p {
    margin-bottom: 1.5rem;
  }

  @media (max-width: 768px) {
    #weihnachten-neujahr .xmas-content {
      padding: 3rem 1.5rem 17rem 1.5rem;
    }
  }
</style>
