---
import { Image } from 'astro:assets';
import TopKontakt from './TopKontakt.astro';
import diaSeal from '../assets/img/dia.png';
import bannerLederhosen from '../assets/img/banner-lederhosen.jpg';
---
<header class="hero">
  <Image src={bannerLederhosen} alt="" class="bg-cover" loading="eager" decoding="async" fetchpriority="high" />
  <TopKontakt />
  <div id="hero" class="manual-hyphen">
    <div class="dia">
      <Image
        src={diaSeal}
        alt="Immobilienmakler zertifiziert nach DIN EN 15733"
        class="seal-logo"
        data-title="Immobilienmakler zertifiziert nach DIN&nbsp;EN&nbsp;15733"
        data-desc="Die DIN EN 15733 ist die europaweit gültige Norm für Immobilienmakler. Sie bescheinigt eine fachliche Mindestqualifikation (z. B. Immobilienfachwirt), regelt strenge Informationspflichten gegenüber Käufer und Verkäufer und verpflichtet zu einem Moralkodex. Dazu gehören Transparenz, Schutz der Kundeninteressen, Diskriminierungsfreiheit, Versicherungsschutz sowie ein internes Beschwerdemanagement. Die Zertifizierung ist freiwillig – ein verlässliches Qualitätssiegel für Verbraucher."
        data-seal="din15733"
        width={300}
        height={300}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="container hero-top">
      <img
        class="hero-logo"
        src="/img/logo_pmi_web.svg"
        alt="Projekt M Immobilien GmbH – Logo"
        width="3220"
        height="1099"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="verlauf">
      <div class="container hero-bottom">
        <h1>Willkommen bei der Projekt M Immobilien</h1>
        <p class="lead">Ihr starker Partner rund um die Immobilie in München und Landshut.</p>
      </div>
    </div>
  </div>
</header>
