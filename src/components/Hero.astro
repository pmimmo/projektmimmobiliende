---
import { Image, Picture } from "astro:assets";
import TopKontakt from "./TopKontakt.astro";
import diaSeal from "../assets/img/dia.png";
// import bannerLederhosen from "../assets/img/banner-lederhosen.jpg";
import bannerOper from "../assets/img/banner-oper-erweitert.jpg";
---

<header class="hero">
    <Picture src={bannerOper} formats={["avif", "webp"]} alt="" class="bg-cover" loading="eager" decoding="async" fetchpriority="high" />
    <TopKontakt />
    <div id="hero" class="manual-hyphen">
        <div class="dia">
            <Image src={diaSeal} alt="Immobilienmakler zertifiziert nach DIN EN 15733" class="seal-logo" data-title="Immobilienmakler zertifiziert nach DIN EN 15733" data-desc="Die DIN EN 15733 ist die europaweit gültige Norm für Immobilienmakler. Sie bescheinigt eine fachliche Mindestqualifikation (z. B. Immobilienfachwirt), regelt strenge Informationspflichten gegenüber Käufer und Verkäufer und verpflichtet zu einem Moralkodex. Dazu gehören Transparenz, Schutz der Kundeninteressen, Diskriminierungsfreiheit, Versicherungsschutz sowie ein internes Beschwerdemanagement. Die Zertifizierung ist freiwillig – ein verlässliches Qualitätssiegel für Verbraucher." data-seal="din15733" width={300} height={300} loading="lazy" decoding="async" />
        </div>
        <div class="container hero-top">
            <img class="hero-logo" src={`${import.meta.env.BASE_URL}img/logo_pmi_web.svg`} alt="Projekt M Immobilien GmbH – Logo" width="3220" height="1099" decoding="async" fetchpriority="high" />
        </div>
        <div class="verlauf verlauf-none">
            <div class="container hero-center">
                <h1>Willkommen bei der Projekt M Immobilien</h1>
                <p class="lead">Ihr starker Partner rund um die Immobilie in München und Landshut.</p>
            </div>
        </div>
    </div>
</header>

<style>
    header {
        height: 100vh;
        height: 100dvh;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        isolation: isolate;
    }

    #hero {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex: 1;
        position: relative;
    }

    #hero .dia {
        position: absolute;
        top: -15px;
        right: 5vw;
        text-align: end;
        background: white;
        border-radius: 50%;
        transform: rotate(20deg);
        aspect-ratio: 1 / 1;
        width: clamp(80px, 20vw, 180px);
        overflow: hidden;
        z-index: 3;
    }
    #hero .dia :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    #hero .hero-logo {
        filter: brightness(0) invert(1) drop-shadow(0 0 4px rgba(0, 0, 0, 1));
        width: 200px;
        max-width: 100%;
        height: auto;
        pointer-events: none;
    }

    .hero-top,
    .hero-bottom {
        width: 100%;
        display: flex;
    }
    .hero-top {
        justify-content: center;
        align-items: flex-start;
        margin-top: 5rem;
    }
    .hero-bottom {
        height: 100%;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        gap: 1.25rem;
    }

    @media screen and (min-width: 769px) {
        .hero-top {
            justify-content: flex-start;
            margin-top: 1rem;
        }
    }

    header #hero .verlauf {
        position: relative;
        display: flex;
        flex-grow: 1;
        flex-direction: column;
        justify-content: flex-end;
        padding-bottom: 0;
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.9) 100%);
    }

    header #hero .verlauf-none {
        background: none;
    }

    header.hero h1 {
        font-size: clamp(2.2rem, 2.5vw + 1rem, 4rem);
        font-weight: 600;
        color: white;
        margin-top: 2.5rem;
        text-shadow:
            0 0 4px rgba(0, 0, 0, 0.7),
            0 0 8px rgba(0, 0, 0, 0.5);
        text-align: center;
        padding-inline-start: max(1rem, env(safe-area-inset-left));
        padding-inline-end: max(1rem, env(safe-area-inset-right));
        padding-block-start: env(safe-area-inset-top);
        padding-block-end: 0;
    }

    header.hero p.lead {
        font-size: clamp(1.2rem, 1vw + 0.8rem, 1.6rem);
        font-weight: 300;
        color: white;
        text-align: center;
        text-shadow:
            0 0 4px rgba(0, 0, 0, 0.7),
            0 0 8px rgba(0, 0, 0, 0.5);
        margin-bottom: 15vh;
        padding-inline-start: max(1rem, env(safe-area-inset-left));
        padding-inline-end: max(1rem, env(safe-area-inset-right));
        padding-block-start: env(safe-area-inset-top);
        padding-block-end: 0;
    }
</style>
