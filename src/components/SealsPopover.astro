---
import Icon from './Icon.astro';
---
<div id="logo-popover" popover="auto" role="dialog" aria-labelledby="lp-title" aria-describedby="lp-desc">
  <button type="button" class="lp-close" popovertarget="logo-popover" popovertargetaction="hide" aria-label="Schließen">
    <Icon name="xmark" />
  </button>
  <h4 id="lp-title"></h4>
  <div class="lp-body">
    <img id="lp-img" alt="" />
    <div class="lp-text">
      <div>
        <p id="lp-desc"></p>
        <p id="lp-certificateHolder"></p>
      </div>
      <p id="lp-link-wrap" hidden>
        <a id="lp-link" class="button" target="_blank" rel="nofollow noopener">Siegel validieren</a>
      </p>
    </div>
  </div>
</div>

<script>
  import '../scripts/seals-popover.ts';
</script>

<style>
  #logo-popover {
    position: fixed;
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    max-width: min(90vw, 720px);
    min-width: 300px;
    width: 100%;
    min-height: 500px;
    max-height: 80vh;
    border: 1px solid transparent;
    border-radius: 1.5rem;
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(2px);
    padding: 2.5rem 2rem 1.25rem 2rem;
    align-content: flex-start;
    box-shadow: var(--shadow-edge), 0 8px 24px 0px #00000066, 0 8px 8px 0px #00000020 inset;
  }
  #logo-popover:popover-open { animation: pop-in .12s ease-out; }
  @keyframes pop-in { from { opacity: 0; transform: translate(-50%, -52%) scale(.98); } to { opacity: 1; transform: translate(-50%, -50%) scale(1); } }

  #logo-popover .lp-body { display: grid; grid-template-columns: 1fr 2fr; gap: 1rem; align-items: start; justify-items: stretch; }
  #logo-popover h4 {font-weight: 500; margin-top: 0; margin-bottom: 3rem;}
  #logo-popover .lp-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    align-self: stretch;
  }
  #logo-popover .lp-text h4 { margin: 0 0 1rem 0; font-weight: 500;}
  #logo-popover img#lp-img {  width: auto; max-height: 250px; object-fit: contain; padding: .5rem; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.4)); }

  #logo-popover #lp-link-wrap { margin-top: 1rem; }

  #logo-popover .lp-close {
    position: absolute;
    top: .4rem;
    right: .4rem;
    border: none;
    background: rgba(255, 255, 255, 0.8);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: .25rem;
    border-radius: 50%;
    aspect-ratio: 1 / 1;
    width: 40px;
    color: var(--c-text);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-edge);
    transition: transform .2s ease;
  }

  #logo-popover .lp-close:hover {
    background-color: white;
    transform: scale(1.25);
  }

  #logo-popover .lp-close:active {
    background-color: tomato;
    color: white !important;
  }

  #logo-popover .lp-close:hover, #logo-popover .lp-close:focus-visible { color: #000; }

  #logo-popover::backdrop {
    background: rgba(0,0,0,.35);
    backdrop-filter: blur(3px);
  }

  @media (max-width: 640px) {
    #logo-popover h4 {text-align: center; margin-top: 2rem; margin-bottom: 1rem;}
    #logo-popover .lp-body { grid-template-columns: 1fr; text-align: left; }
    #logo-popover img#lp-img { margin: 0 auto; width: 300px; max-width: 100%; max-height: 200px;}
  }
</style>
