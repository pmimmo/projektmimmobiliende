---
const base = import.meta.env.BASE_URL;

const sections = [
  { href: `${base}seo-preview/`, label: 'Start' },
  { href: `${base}seo-preview/leistungen/`, label: 'Leistungen' },
  { href: `${base}seo-preview/standorte/`, label: 'Standorte' },
  { href: `${base}seo-preview/team/`, label: 'Team' },
  { href: `${base}seo-preview/zertifikate/`, label: 'Kompetenzen' },
];
---

<header class="seo-preview-nav">
  <div class="seo-preview-nav__inner">
    <a class="seo-preview-nav__brand" href={`${base}seo-preview/`}>
      <img src={`${base}img/logo_pmi_web.svg`} alt="Projekt M Immobilien GmbH – Logo" width="3220" height="1099" />
      <span>Neue Struktur</span>
    </a>
    <nav aria-label="Preview Navigation">
      {
        sections.map((section) => (
          <a href={section.href}>{section.label}</a>
        ))
      }
    </nav>
    <a class="seo-preview-nav__live" href={`${base}seo-preview/content-model/`}>Datenmodell</a>
  </div>
</header>

<style>
  .seo-preview-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    margin-bottom: 0;
    border-bottom: 1px solid var(--c-background-gray);
    background: color-mix(in srgb, white 92%, transparent);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .seo-preview-nav__inner {
    width: min(1180px, calc(100% - 2rem));
    min-height: 74px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
  }

  .seo-preview-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-weight: 700;
  }

  .seo-preview-nav__brand img {
    width: 120px;
    height: auto;
  }

  .seo-preview-nav nav {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .seo-preview-nav nav a,
  .seo-preview-nav__live {
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    color: var(--c-text);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .seo-preview-nav nav a:hover,
  .seo-preview-nav__live:hover {
    background: var(--c-gray-200);
    text-decoration: none;
  }

  .seo-preview-nav__live {
    border: 1px solid var(--c-background-gray);
  }

  @media (max-width: 820px) {
    .seo-preview-nav__inner {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 0.75rem 0;
    }

    .seo-preview-nav nav {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.25rem;
    }

    .seo-preview-nav nav a {
      white-space: nowrap;
    }

    .seo-preview-nav__live {
      justify-self: start;
    }
  }
</style>
