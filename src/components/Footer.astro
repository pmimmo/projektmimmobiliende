---
---
<footer>
  <div class="container"></div>
  <div class="container spalten">
    <div>
      <a href={import.meta.env.BASE_URL}>
        <img src={`${import.meta.env.BASE_URL}img/logo_pmi_web.svg`} alt="Projekt M Immobilien GmbH – Logo" width="3220" height="1099" />
      </a>
      <p class="condensed"><small>&copy; 2003–{new Date().getFullYear()} Projekt M Immobilien GmbH</small></p>
    </div>
    <div class="nav">
      <div><a href={`${import.meta.env.BASE_URL}#leistungen`}>Leistungen</a></div>
      <div><a href={`${import.meta.env.BASE_URL}#team`}>Team</a></div>
      <div><a href={`${import.meta.env.BASE_URL}#kompetenzen`}>Kompetenzen</a></div>
      <div><a href={`${import.meta.env.BASE_URL}#standorte`}>Standorte</a></div>
      <div><a href={`${import.meta.env.BASE_URL}#callToAction`}>Kontakt</a></div>
      <div><a href={`${import.meta.env.BASE_URL}impressum/`}>Impressum</a></div>
      <div><a href={`${import.meta.env.BASE_URL}datenschutz/`}>Datenschutz</a></div>
    </div>
    <div>
      <address>
        <p>
          Projekt M Immobilien GmbH<br />
          Krumbacherstraße 5<br />80798 München
        </p>
      </address>
    </div>
    <div>
      <p>
        Telefon <a href="tel:+498928806768">089 28806768</a><br />
        E-Mail <a href="mailto:info@pmimmo.de">info@pmimmo.de</a>
      </p>
    </div>
  </div>
</footer>

<style>
  footer {
    position: relative;
    background-color: var(--c-gray-300);
    padding: 4rem 0;
  }

  footer:after {
    content: "";
    position: absolute;
    bottom: 0;
    right: clamp(1rem, calc((100vw - 1200px)/2 + 1rem), 217px);
    width: 300px;
    aspect-ratio: 166 / 87;
    background-image: url("/img/logo-boegen.svg");
    background-repeat: no-repeat;
    background-size: contain;
    background-position: right bottom;
    filter: grayscale(1) brightness(0);
    opacity: 0.08;
    pointer-events: none;
  }

  .spalten { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .container .nav { display: flex; flex-direction: column; justify-content: flex-start; }
  footer img {
    height: 60px;
    margin-bottom: 1.5rem;
    padding: env(safe-area-inset-top)  env(safe-area-inset-right)  0  env(safe-area-inset-left);
  }
  footer address { font-style: normal; }
  footer a { cursor: pointer; }
  footer a:hover { text-decoration: underline; }

  @media screen and (max-width: 1000px) {
    .spalten { grid-template-columns: repeat(2, 1fr); }
    footer::after { display: none; }
  }

  @media screen and (max-width: 640px) {
    .container, .spalten {
      grid-template-columns: repeat(1, 1fr);
      text-align: center;
    }
  }
</style>
