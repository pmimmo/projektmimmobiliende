---
import BaseLayout from './BaseLayout.astro';
import SeoPreviewNavigation from '../components/SeoPreviewNavigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  eyebrow?: string;
}

const { title, description, canonicalPath, eyebrow = 'Interne SEO-Vorschau' } = Astro.props;
const site = import.meta.env.SITE;
---

<BaseLayout
  title={`${title} – Projekt M Immobilien`}
  description={description}
  canonical={`${site}${canonicalPath}`}
  robots="noindex, nofollow"
  schema="none"
>
  <SeoPreviewNavigation />
  <main id="main-content" class="seo-preview-shell">
    <section class="seo-preview-hero">
      <div>
        <p class="seo-preview-eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </div>
      <aside class="seo-preview-hero__aside" aria-label="Preview Status">
        <strong>Interner Entwurf</strong>
        <span>Nicht indexierbar, geschützt und noch nicht Teil der Live-Navigation.</span>
      </aside>
    </section>
    <slot />
  </main>
  <Footer />
</BaseLayout>

<style>
  .seo-preview-shell {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto 5rem;
  }

  .seo-preview-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 340px);
    gap: 2rem;
    align-items: end;
    padding: 3.5rem 0 3rem;
    border-bottom: 1px solid var(--c-background-gray);
  }

  .seo-preview-hero h1 {
    max-width: 14ch;
    margin-bottom: 1rem;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 0.98;
  }

  .seo-preview-hero .lead {
    max-width: 760px;
  }

  .seo-preview-hero__aside {
    padding: 1rem;
    border-left: 4px solid var(--c-primary);
    background: var(--c-gray-100);
    font-size: 1rem;
  }

  .seo-preview-hero__aside strong,
  .seo-preview-hero__aside span {
    display: block;
  }

  .seo-preview-eyebrow,
  :global(.seo-preview-eyebrow) {
    margin-bottom: 0.5rem;
    color: var(--c-primary-dark);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  :global(.seo-preview-section) {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--c-background-gray);
  }

  :global(.seo-preview-section-header) {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  :global(.seo-preview-section-header h2) {
    margin: 0;
  }

  :global(.seo-preview-section-header p) {
    max-width: 520px;
    margin: 0;
  }

  :global(.seo-preview-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  :global(.seo-preview-card) {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--c-background-gray);
    border-radius: 8px;
    background: var(--c-gray-100);
  }

  :global(.seo-preview-card-link) {
    min-height: 100%;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  :global(.seo-preview-card-link:hover) {
    border-color: var(--c-primary);
    background: white;
    transform: translateY(-2px);
    text-decoration: none;
  }

  :global(.seo-preview-card--dark) {
    background: var(--c-background-dark);
    color: var(--c-text-light);
  }

  :global(.seo-preview-card--dark a) {
    color: var(--c-text-light);
  }

  :global(.seo-preview-kicker) {
    color: var(--c-primary-dark);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  :global(.seo-preview-card h2),
  :global(.seo-preview-card h3) {
    margin-top: 0;
  }

  :global(.seo-preview-link) {
    display: inline-flex;
    align-items: center;
    margin-top: 0.75rem;
    font-weight: 700;
  }

  :global(.seo-preview-list) {
    display: grid;
    gap: 0.65rem;
    margin: 1rem 0 0;
    list-style: none;
  }

  :global(.seo-preview-list li) {
    margin: 0;
    list-style: none;
  }

  :global(.seo-preview-pill-list) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
  }

  :global(.seo-preview-pill) {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--c-background-gray);
    border-radius: 999px;
    background: white;
    font-size: 0.95rem;
    font-weight: 700;
  }

  :global(.seo-preview-dl) {
    display: grid;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  :global(.seo-preview-dl dt) {
    font-size: 0.85rem;
    font-weight: 700;
  }

  :global(.seo-preview-dl dd) {
    margin: 0;
  }

  @media (max-width: 820px) {
    .seo-preview-hero {
      grid-template-columns: 1fr;
      padding-top: 2.5rem;
    }

    .seo-preview-section-header {
      display: block;
    }
  }
</style>
