---
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import SeoPreviewNavigation from '../components/SeoPreviewNavigation.astro';
import Footer from '../components/Footer.astro';
import bannerOper from '../assets/img/banner-oper-erweitert.jpg';
import diaSeal from '../assets/img/dia.png';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  eyebrow?: string;
  heroVariant?: 'compact' | 'home';
}

const { title, description, canonicalPath, eyebrow = 'Projekt M Immobilien', heroVariant = 'compact' } = Astro.props;
const site = import.meta.env.SITE;
---

<BaseLayout
  title={`${title} – Projekt M Immobilien`}
  description={description}
  canonical={`${site}${canonicalPath}`}
  robots="noindex, nofollow"
  schema="none"
>
  <SeoPreviewNavigation />
  {
    heroVariant === 'home' ? (
      <header class="seo-preview-visual-hero">
        <Picture src={bannerOper} formats={['avif', 'webp']} alt="" class="seo-preview-visual-hero__image" loading="eager" decoding="async" fetchpriority="high" />
        <div class="seo-preview-visual-hero__shade"></div>
        <div class="seo-preview-visual-hero__badge">
          <Picture src={diaSeal} formats={['avif', 'webp']} alt="Immobilienmakler zertifiziert nach DIN EN 15733" loading="eager" decoding="async" />
        </div>
        <div class="seo-preview-visual-hero__inner">
          <img class="seo-preview-visual-hero__logo" src={`${import.meta.env.BASE_URL}img/logo_pmi_web.svg`} alt="Projekt M Immobilien GmbH - Logo" width="3220" height="1099" decoding="async" fetchpriority="high" />
          <div class="seo-preview-visual-hero__copy">
            <p class="seo-preview-eyebrow">{eyebrow}</p>
            <h1>{title}</h1>
            <p class="lead">{description}</p>
          </div>
        </div>
      </header>
    ) : (
      <header class="seo-preview-compact-hero">
        <div class="seo-preview-compact-hero__inner">
          <div>
            <p class="seo-preview-eyebrow">{eyebrow}</p>
            <h1>{title}</h1>
            <p class="lead">{description}</p>
          </div>
        </div>
      </header>
    )
  }
  <main id="main-content" class="seo-preview-shell">
    <slot />
  </main>
  <Footer />
</BaseLayout>

<style>
  :global(body:has(.seo-preview-shell)) {
    overflow-x: clip;
  }

  .seo-preview-visual-hero {
    position: relative;
    min-height: min(82vh, 760px);
    display: grid;
    align-items: stretch;
    overflow: hidden;
    isolation: isolate;
    background: var(--c-background-dark);
  }

  .seo-preview-visual-hero :global(.seo-preview-visual-hero__image) {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
  }

  .seo-preview-visual-hero :global(.seo-preview-visual-hero__image img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seo-preview-visual-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.68) 78%, rgba(0, 0, 0, 0.82) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.58) 0%, rgba(0, 0, 0, 0.24) 48%, rgba(0, 0, 0, 0.18) 100%);
  }

  .seo-preview-visual-hero__inner {
    width: min(1180px, calc(100% - 2rem));
    min-height: inherit;
    margin: 0 auto;
    padding: clamp(5rem, 10vh, 8rem) 0 clamp(3rem, 8vh, 5.5rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(2rem, 7vh, 5rem);
    color: white;
  }

  .seo-preview-visual-hero__logo {
    width: clamp(150px, 14vw, 220px);
    height: auto;
    filter: brightness(0) invert(1) drop-shadow(0 0 4px rgba(0, 0, 0, 1));
  }

  .seo-preview-visual-hero__copy {
    min-width: 0;
    align-self: end;
    width: 100%;
    max-width: min(860px, 100%);
    text-shadow:
      0 0 4px rgba(0, 0, 0, 0.7),
      0 0 12px rgba(0, 0, 0, 0.45);
  }

  .seo-preview-visual-hero h1 {
    max-width: 13ch;
    margin: 0 0 1rem;
    color: white;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    line-height: 0.96;
  }

  .seo-preview-visual-hero .lead {
    max-width: 780px;
    margin: 0;
    color: white;
    font-size: clamp(1.2rem, 1.5vw, 1.75rem);
    font-weight: 300;
  }

  .seo-preview-visual-hero .seo-preview-eyebrow {
    color: white;
  }

  .seo-preview-visual-hero__badge {
    position: absolute;
    top: clamp(4.6rem, 8vw, 6.5rem);
    right: clamp(1rem, 5vw, 5rem);
    width: clamp(90px, 13vw, 160px);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: white;
    transform: rotate(20deg);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
  }

  .seo-preview-visual-hero__badge :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seo-preview-shell {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto 5rem;
  }

  .seo-preview-compact-hero {
    border-bottom: 1px solid var(--c-background-gray);
    background:
      linear-gradient(135deg, rgba(112, 172, 31, 0.12), rgba(255, 255, 255, 0) 42%),
      var(--c-gray-100);
  }

  .seo-preview-compact-hero__inner {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: end;
  }

  .seo-preview-compact-hero h1 {
    max-width: 20ch;
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.06;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .seo-preview-compact-hero .lead {
    max-width: 760px;
    margin: 0;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .seo-preview-compact-hero__aside {
    box-sizing: border-box;
    padding: 1rem 1.1rem;
    border-left: 4px solid var(--c-primary);
    background: white;
    font-size: 1rem;
  }

  .seo-preview-compact-hero__aside strong,
  .seo-preview-compact-hero__aside span {
    display: block;
  }

  .seo-preview-hero__aside {
    width: min(100%, 420px);
    padding: 1rem 1.1rem;
    border-left: 4px solid white;
    background: rgba(255, 255, 255, 0.88);
    color: var(--c-text);
    font-size: 1rem;
    text-shadow: none;
  }

  .seo-preview-hero__aside strong,
  .seo-preview-hero__aside span {
    display: block;
  }

  .seo-preview-eyebrow,
  :global(.seo-preview-eyebrow) {
    margin-bottom: 0.5rem;
    color: var(--c-primary-dark);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  :global(.seo-preview-section) {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    border-bottom: 1px solid var(--c-background-gray);
  }

  :global(.seo-preview-section-header) {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  :global(.seo-preview-section-header h2) {
    margin: 0;
  }

  :global(.seo-preview-section-header p) {
    max-width: 520px;
    margin: 0;
  }

  :global(.seo-preview-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  :global(.seo-preview-grid--two) {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  :global(.seo-preview-split) {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: 2rem;
    align-items: start;
  }

  :global(.seo-preview-card) {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--c-background-gray);
    border-radius: 8px;
    background: var(--c-gray-100);
  }

  :global(.seo-preview-band) {
    box-sizing: border-box;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: clamp(4rem, 8vw, 7rem) max(1rem, calc((100vw - 1180px) / 2));
  }

  :global(.seo-preview-band--gray) {
    background: var(--c-background-gray);
  }

  :global(.seo-preview-highlight) {
    box-sizing: border-box;
    max-width: 100%;
    display: grid;
    grid-template-columns: minmax(130px, 0.6fr) minmax(0, 2fr) minmax(130px, 0.6fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    justify-items: center;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: 2rem;
    background: var(--c-gray-100);
    box-shadow: var(--shadow-highlight), 0 0 0 1px rgba(0, 107, 82, 0.15);
  }

  :global(.seo-preview-highlight__media img) {
    width: min(180px, 34vw);
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
  }

  :global(.seo-preview-highlight__badge img) {
    width: min(180px, 34vw);
    height: auto;
    object-fit: contain;
  }

  :global(.seo-preview-highlight__text) {
    min-width: 0;
    max-width: 100%;
    text-align: center;
  }

  :global(.seo-preview-highlight__text h2) {
    margin-top: 0.35rem;
    color: rgb(0, 107, 82);
  }

  :global(.seo-preview-feature-tiles) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  :global(.seo-preview-feature-tile) {
    box-sizing: border-box;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.4rem;
    border-radius: 8px;
    background: var(--c-background-dark);
    color: white;
    text-decoration: none;
    box-shadow: inset 0 -160px 140px rgba(0, 0, 0, 0.55);
  }

  :global(.seo-preview-feature-tile:hover) {
    transform: translateY(-2px);
    text-decoration: none;
  }

  :global(.seo-preview-feature-tile h3),
  :global(.seo-preview-feature-tile p),
  :global(.seo-preview-feature-tile .seo-preview-kicker) {
    color: white;
  }

  :global(.seo-preview-statement) {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  :global(.seo-preview-statement__copy h2) {
    margin-top: 0;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.05;
  }

  :global(.seo-preview-statement__note) {
    box-sizing: border-box;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-left: 4px solid var(--c-primary);
    background: white;
  }

  :global(.seo-preview-card-link) {
    min-height: 100%;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  :global(.seo-preview-card-link:hover) {
    border-color: var(--c-primary);
    background: white;
    transform: translateY(-2px);
    text-decoration: none;
  }

  :global(.seo-preview-card--dark) {
    background: var(--c-background-dark);
    color: var(--c-text-light);
  }

  :global(.seo-preview-card--dark a) {
    color: var(--c-text-light);
  }

  :global(.seo-preview-panel) {
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 8px;
    background: var(--c-background-dark);
    color: var(--c-text-light);
  }

  :global(.seo-preview-panel a) {
    color: var(--c-text-light);
  }

  :global(.seo-preview-kicker) {
    color: var(--c-primary-dark);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  :global(.seo-preview-card h2),
  :global(.seo-preview-card h3) {
    margin-top: 0;
  }

  :global(.seo-preview-media-card) {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    border: 1px solid var(--c-background-gray);
    border-radius: 8px;
    background: white;
  }

  :global(.seo-preview-media-card__image) {
    display: grid;
    place-items: center;
    height: 260px;
    padding: 1.5rem;
    background: var(--c-gray-100);
  }

  :global(.seo-preview-media-card__image img) {
    max-width: 100%;
    max-height: 260px;
    object-fit: contain;
  }

  :global(.seo-preview-media-card__body) {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  :global(.seo-preview-media-card__body p:last-child) {
    margin-top: auto;
  }

  :global(.seo-preview-cert-grid) {
    grid-auto-rows: 1fr;
  }

  :global(.seo-preview-cert-card .seo-preview-media-card__image) {
    height: 220px;
  }

  :global(.seo-preview-cert-card .seo-preview-media-card__image img) {
    max-height: 175px;
  }

  :global(.seo-preview-cert-card h3) {
    font-size: 1.18rem;
    line-height: 1.25;
  }

  :global(.seo-preview-person-intro) {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  :global(.seo-preview-person-intro__image img) {
    width: min(320px, 100%);
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center top;
    border-radius: 50%;
  }

  :global(.seo-preview-person-intro__image) {
    display: grid;
    justify-items: center;
  }

  :global(.seo-preview-location-intro) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  :global(.seo-preview-location-intro__map img) {
    width: 100%;
    border-radius: 8px;
    box-shadow: var(--shadow-highlight);
  }

  :global(.seo-preview-link) {
    display: inline-flex;
    align-items: center;
    margin-top: 0.75rem;
    font-weight: 700;
  }

  :global(.seo-preview-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  :global(.seo-preview-secondary-link) {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1rem;
    border: 1px solid var(--c-background-gray);
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }

  :global(.seo-preview-secondary-link:hover) {
    background: var(--c-gray-100);
    text-decoration: none;
  }

  :global(.seo-preview-list) {
    display: grid;
    gap: 0.65rem;
    margin: 1rem 0 0;
    list-style: none;
  }

  :global(.seo-preview-list li) {
    margin: 0;
    list-style: none;
  }

  :global(.seo-preview-check-list) {
    display: grid;
    gap: 0.85rem;
    margin: 1rem 0 0;
    list-style: none;
  }

  :global(.seo-preview-check-list li) {
    position: relative;
    margin: 0;
    padding-left: 1.35rem;
    list-style: none;
  }

  :global(.seo-preview-check-list li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--c-primary);
  }

  :global(.seo-preview-pill-list) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
  }

  :global(.seo-preview-pill) {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--c-background-gray);
    border-radius: 999px;
    background: white;
    font-size: 0.95rem;
    font-weight: 700;
  }

  :global(.seo-preview-dl) {
    display: grid;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  :global(.seo-preview-dl dt) {
    font-size: 0.85rem;
    font-weight: 700;
  }

  :global(.seo-preview-dl dd) {
    margin: 0;
  }

  @media (max-width: 820px) {
    .seo-preview-visual-hero {
      min-height: 720px;
    }

    .seo-preview-visual-hero__inner {
      padding-top: 6rem;
      gap: 2rem;
    }

    .seo-preview-visual-hero__badge {
      top: 5.25rem;
      right: 1rem;
      width: 82px;
    }

    .seo-preview-visual-hero h1 {
      max-width: 8ch;
      font-size: clamp(2.25rem, 11vw, 2.85rem);
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .seo-preview-visual-hero .lead {
      max-width: 19rem;
      font-size: 0.98rem;
      line-height: 1.45;
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .seo-preview-visual-hero .seo-preview-eyebrow {
      white-space: normal;
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .seo-preview-hero__aside {
      width: 100%;
    }

    :global(.seo-preview-split) {
      grid-template-columns: 1fr;
    }

    :global(.seo-preview-highlight),
    :global(.seo-preview-feature-tiles),
    :global(.seo-preview-statement),
    :global(.seo-preview-person-intro),
    :global(.seo-preview-location-intro),
    .seo-preview-compact-hero__inner {
      grid-template-columns: 1fr;
    }

    .seo-preview-compact-hero h1 {
      font-size: clamp(1.9rem, 9vw, 2.65rem);
      max-width: 100%;
    }

    .seo-preview-compact-hero .lead {
      font-size: 1.1rem;
      line-height: 1.5;
    }

    :global(.seo-preview-highlight) {
      width: 100%;
      box-sizing: border-box;
      padding: 2rem 1rem;
      border-radius: 1rem;
    }

    :global(.seo-preview-highlight__media),
    :global(.seo-preview-highlight__badge) {
      min-width: 0;
    }

    :global(.seo-preview-highlight__text .lead) {
      font-size: 1.12rem;
      line-height: 1.55;
      overflow-wrap: break-word;
      hyphens: auto;
    }

    :global(.seo-preview-highlight__text h2) {
      font-size: clamp(1.45rem, 6.4vw, 1.8rem);
      overflow-wrap: break-word;
      hyphens: auto;
    }

    :global(.seo-preview-actions) {
      justify-content: center;
    }

    .seo-preview-section-header {
      display: block;
    }
  }
</style>
