---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  breadcrumbTitle?: string;
  robots?: string;
  schema?: 'business' | 'none';
}

const { title, description, canonical, breadcrumbTitle, robots, schema = 'none' } = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType="website"
  dataPage="legal"
  breadcrumbTitle={breadcrumbTitle}
  robots={robots}
  schema={schema}
>
  <Navigation />
  <main id="main-content" class="container">
    <slot />
  </main>
  <Footer />
</BaseLayout>
